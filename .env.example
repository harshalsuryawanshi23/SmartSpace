# =====================================================================
# SmartSpace — environment template
# Copy to `.env` and fill in. NEVER commit the real .env or any secrets.
# Only variables prefixed VITE_ are exposed to the browser (public values only).
# =====================================================================

# ---------- App ----------
SPRING_PROFILES_ACTIVE=dev              # dev | prod
APP_BASE_URL=https://smartspace.local   # public URL of the web app
API_BASE_URL=https://smartspace.local/api
APP_TIMEZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=https://smartspace.local,http://localhost:5173

# ---------- Database (MySQL 8.4) ----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=smartspace
MYSQL_USER=smartspace
MYSQL_PASSWORD=
DB_URL=jdbc:mysql://mysql:3306/smartspace?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
DB_USER=smartspace
DB_PASSWORD=

# ---------- Auth ----------
JWT_SECRET=                             # >= 32 random bytes (base64); e.g. `openssl rand -base64 48`
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=3
OTP_PEPPER=                             # random secret used to HMAC OTP codes at rest

# ---------- QR signing (Ed25519) ----------
# Generate with: infra/scripts/gen-qr-keys.sh  (openssl genpkey -algorithm ed25519 ...)
QR_PRIVATE_KEY_PATH=/run/keys/qr_private.pem
QR_PUBLIC_KEY_PATH=/run/keys/qr_public.pem
QR_KEY_ID=k1

# ---------- Data protection ----------
PII_ENCRYPTION_KEY_B64=                 # 32 random bytes, base64 (AES-256-GCM for optional field encryption)

# ---------- Identity / KYC ----------
KYC_PROVIDER=mock                       # mock only in the academic build. Never store raw Aadhaar numbers.
KYC_API_KEY=
KYC_API_SECRET=

# ---------- Payments ----------
PAYMENT_PROVIDER=mock                   # mock | razorpay (TEST mode keys only in dev/staging)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=5
TAX_PERCENT=18

# ---------- Booking rules ----------
SLOT_LOCK_MINUTES=10

# ---------- Notifications ----------
SMS_PROVIDER=console                    # console | <real provider adapter>
SMS_API_KEY=
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@smartspace.local

# ---------- Storage ----------
FILE_STORAGE_PATH=/app/uploads
MAX_UPLOAD_MB=5

# ---------- Dev seed (dev profile only) ----------
SEED_PASSWORD=Demo@12345

# ---------- Feature flags (default on) ----------
FEATURE_OFFLINE_GATE=true
FEATURE_CAPACITY_GUARD=true
FEATURE_QUIET_GUARD=true
FEATURE_DECORATOR_PASS=true
FEATURE_COMMUNITY_PRICING=true
FEATURE_WAITLIST=true
FEATURE_EVIDENCE_PACK=true
FEATURE_PRIVACY_DASHBOARD=true
FEATURE_SPLIT_PAY=false
FEATURE_NL_BRIEF=false
FEATURE_WEB_PUSH=false

# ---------- Frontend (public values only) ----------
VITE_API_BASE_URL=/api/v1
VITE_RAZORPAY_KEY_ID=                   # public test key id only
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_DEFAULT_LAT=18.5204
VITE_DEFAULT_LNG=73.8567
VITE_DEFAULT_LANGUAGE=en
